FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api && \
    mkdir -p /out/app-artifacts

FROM gcr.io/distroless/base-debian12
ENV VERSION=container
WORKDIR /app
COPY --chown=nonroot:nonroot --from=build /out/api /app/api
COPY --chown=nonroot:nonroot --from=build /out/app-artifacts /app/artifacts
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/api"]
